rules_version = '2';

// Deny-by-default security rules. Role enforcement via the members collection.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(uid) {
      return get(/databases/$(database)/documents/members/$(uid)).data;
    }

    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function myRole() {
      return memberDoc(request.auth.uid).role;
    }

    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'haseeb.a@ziriumai.com' ||
        request.auth.token.email.lower() == 'haseeb.a@zirium.com' ||
        request.auth.token.email.lower() == 'ziriumai@gmail.com'
      );
    }

    function isAdmin() {
      return (isMember() && myRole() in ['owner', 'admin']) || isOwnerEmail();
    }

    // User profiles (display name, photo, email).
    match /users/{uid} {
      allow read: if isMember();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Company membership + role. Heart of permissions.
    match /members/{uid} {
      // You can always read your own membership, even before it exists.
      allow read: if isSignedIn() && (request.auth.uid == uid || isMember());

      // Self-join: plain members join as 'member'; owner emails can self-create as 'owner'.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.role == 'member'
          || isOwnerEmail()
        );

      // Only owners/admins can change roles; users can sync their own doc without escalating.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // Company Documents (guidelines, NDAs, etc) — admin-only writes.
    match /documents/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Teams inside the company.
    match /teams/{teamId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Projects — any member can read/write, admin-only delete.
    match /projects/{projectId} {
      allow read: if isMember();

    // On create, caller must stamp themselves as creator.
    allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isMember();

      allow delete: if isAdmin();
    }

    // Developers (employee) roster — admin-only writes.
    match /developers/{devId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    // Daily tasks — admin creates/deletes, any member can read/update (for reporting).
    match /tasks/{taskId} {
      allow read, update: if isMember();
      allow create, delete: if isAdmin();
    }

    // Office settings — admin writes, all members read.
    match /settings/{settingId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Attendance records — admin has full access, employees can read/write own records.
    match /attendance/{recordId} {
      allow read: if isMember();
      allow create: if isAdmin() || (isMember() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (isMember() && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Finance — admin-only. Sensitive data, no member-level access.
    match /financeProjects/{id} {
      allow read, write: if isAdmin();
    }
    match /invoices/{id} {
      allow read, write: if isAdmin();
    }
    match /allotments/{id} {
      allow read, write: if isAdmin();
    }

    // Monthly Expenses — members can create (salary flow), admin-only modify/delete.
    match /monthlyExpenses/{id} {
      allow read: if isAdmin();
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }

    // Salaries — admin only.
    match /salaries/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // Sick Leave Requests
    match /leaveRequests/{id} {
      allow read, create: if isMember();
      allow update, delete: if isAdmin();
    }

    // Announcements
    match /announcements/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Admin Logs — append-only for members; read by admins only.
    match /admin_logs/{id} {
      allow read, delete: if isAdmin();
      allow create: if isMember();
      allow update: if false;
    }

    // Personal Tasks - users can only read and write their own tasks.
    match /personal_tasks/{taskId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Integrations (Slack tokens) — blocked client-side; server-only via Cloud Functions.
    match /integrations/{id} {
      allow read, write: if false;
    }

    // Everything else is locked until explicit rules are added.
  }
}
