rules_version = '2';

// Storage rules — hardened July 2026. Least-privilege per bucket path.
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if the caller has an admin/owner role in Firestore.
    // Helper: check if the caller has an admin/owner role in Firestore.
    function isAdmin() {
      return request.auth != null
        && (
          (firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
           && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.role in ['owner', 'admin'])
          || request.auth.token.admin == true
        );
    }

    // Task report attachments — members can read their own; admins can read all; only members write to their own task path.
    match /task-reports/{taskId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Company documents (NDAs, guidelines) — admin write only; members can read.
    match /documents/{docId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Finance project files — admin only.
    match /financeProjects/{projectId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Salary slips / payroll PDFs and any finance attachments — admin only.
    match /finance/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Temporary AI import staging — any authenticated user (needed for document parsing).
    match /temp/ai-imports/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Leave request attachments — only the owner or an admin.
    match /leaveRequests/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // Profile pictures — anyone can read; only the owner can write.
    match /profiles/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
