rules_version = '2';

// Storage rules for task-report file uploads.
// Any signed-in user can read/write under task-reports/. (Tighten later to
// restrict writes to the task's assignee or an admin.)
service firebase.storage {
  match /b/{bucket}/o {
    match /task-reports/{taskId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
