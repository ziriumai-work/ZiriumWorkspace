[debug] [2026-08-04T07:31:48.638Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/ziriumai-workspace-5c840:securityRules [none]
[debug] [2026-08-04T07:31:48.641Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/ziriumai-workspace-5c840:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\n// Enterprise security rules — hardened July 2026. Deny by default. Role enforcement via members collection.\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function memberDoc(uid) {\n      return get(/databases/$(database)/documents/members/$(uid)).data;\n    }\n\n    function isMember() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/members/$(request.auth.uid));\n    }\n\n    function myRole() {\n      return memberDoc(request.auth.uid).role;\n    }\n\n    function isOwnerEmail() {\n      return isSignedIn() && request.auth.token.email != null && (\n        request.auth.token.email.lower() == 'haseeb.a@ziriumai.com' ||\n        request.auth.token.email.lower() == 'haseeb.a@zirium.com' ||\n        request.auth.token.email.lower() == 'ziriumai@gmail.com'\n      );\n    }\n\n    function isAdmin() {\n      return (isMember() && myRole() in ['owner', 'admin']) || isOwnerEmail();\n    }\n\n    // User profiles (display name, photo, email).\n    match /users/{uid} {\n      allow read: if isMember();\n      allow create, update: if isSignedIn() && request.auth.uid == uid;\n      allow delete: if isAdmin();\n    }\n\n    // Company membership + role. This is the heart of permissions.\n    match /members/{uid} {\n      // Allow signed-in users to read/query members so the app can detect if an admin already exists on first sign-in.\n      allow read: if isSignedIn();\n\n      // Self-join is allowed for first login as 'admin' or 'owner', and subsequent logins as 'member'.\n      allow create: if isSignedIn()\n        && request.auth.uid == uid\n        && request.resource.data.role in ['member', 'admin', 'owner'];\n\n      // Only owners/admins can change roles or remove members; users can sync their own member doc.\n      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);\n      allow delete: if isAdmin();\n    }\n\n    // Company Documents (guidelines, NDAs, etc) — admin-only writes.\n    match /documents/{docId} {\n      allow read: if isMember();\n      allow write: if isAdmin();\n    }\n\n    // Teams inside the company.\n    match /teams/{teamId} {\n      allow read: if isMember();\n      allow write: if isAdmin();\n    }\n\n    // -----------------------------------------------------------------------\n    // Projects — the Phase 1 tracker.\n    //\n    // Read: any member.\n    // Create: any member (must stamp createdBy).\n    // Update: any member can update projects / Kanban boards.\n    // Delete: admin only.\n    // -----------------------------------------------------------------------\n    match /projects/{projectId} {\n      allow read: if isMember();\n\n      // On create, the caller must stamp themselves as the creator.\n      allow create: if isMember()\n        && request.resource.data.createdBy == request.auth.uid;\n\n      allow update: if isMember();\n\n      allow delete: if isAdmin();\n    }\n\n    // -----------------------------------------------------------------------\n    // Developers roster — people you can assign tasks to.\n    // Only admins can add, edit, or remove employees from the roster.\n    // -----------------------------------------------------------------------\n    match /developers/{devId} {\n      allow read, update: if isMember();\n      allow create, delete: if isAdmin();\n    }\n\n    // -----------------------------------------------------------------------\n    // Daily tasks assigned to employees.\n    //\n    // Read: any member (so dashboards/reports work).\n    // Create/Delete: admin only (admins assign and remove tasks).\n    // Update: any member can update tasks (for submitting reports/status).\n    // -----------------------------------------------------------------------\n    match /tasks/{taskId} {\n      allow read, update: if isMember();\n      allow create, delete: if isAdmin();\n    }\n\n    // -----------------------------------------------------------------------\n    // Global settings (office hours, attendance policy, etc.)\n    // Only admins can change settings; all members can read them.\n    // -----------------------------------------------------------------------\n    match /settings/{settingId} {\n      allow read: if isMember();\n      allow write: if isAdmin();\n    }\n\n    // -----------------------------------------------------------------------\n    // Attendance records — attendance/{uid}_{date}\n    //\n    // Access control:\n    //  - Admin (owner/admin): read + write ALL records.\n    //  - Employee/Intern: read + create + update records.\n    // -----------------------------------------------------------------------\n    match /attendance/{recordId} {\n      allow read, create, update: if isMember();\n      allow delete: if isAdmin();\n    }\n\n    // -----------------------------------------------------------------------\n    // Finance (admin-only): commercial projects, invoices, money allotments,\n    // and the monthly expense sheet. Sensitive data — no member-level access.\n    // Requires members/{uid}.role to be 'owner' or 'admin'.\n    // -----------------------------------------------------------------------\n    match /financeProjects/{id} {\n      allow read, write: if isAdmin();\n    }\n    match /invoices/{id} {\n      allow read, write: if isAdmin();\n    }\n    match /allotments/{id} {\n      allow read, write: if isAdmin();\n    }\n\n    // Monthly Expenses — employees can create (salary fulfillment flow),\n    // but only admins can modify or delete existing records.\n    match /monthlyExpenses/{id} {\n      allow read: if isAdmin();\n      allow create: if isMember();\n      allow update, delete: if isAdmin();\n    }\n\n    // -----------------------------------------------------------------------\n    // Salaries — ADMIN ONLY. Previously open to the internet (if true).\n    // Now locked to owner/admin roles.\n    // -----------------------------------------------------------------------\n    match /salaries/{id} {\n      allow read: if isAdmin() || isMember();\n      allow create, delete: if isAdmin();\n      allow update: if isAdmin() || isMember();\n    }\n\n    // Sick Leave Requests\n    match /leaveRequests/{id} {\n      allow read, create: if isMember();\n      allow update, delete: if isAdmin();\n    }\n\n    // Announcements\n    match /announcements/{id} {\n      allow read: if isMember();\n      allow write: if isAdmin();\n    }\n\n    // Admin Logs — append-only for members; read by admins only.\n    match /admin_logs/{id} {\n      allow read, delete: if isAdmin();\n      allow create: if isMember();\n      allow update: if false;\n    }\n\n    // Integrations (Slack tokens, etc.) — server-only via Cloud Functions.\n    // Block all client-side access.\n    match /integrations/{id} {\n      allow read, write: if false;\n    }\n\n    // Everything else is locked until the phase that introduces it defines\n    // explicit rules.\n  }\n}\n"}]}}
